managed implementation in class zbp_i_ps_order unique;
strict ( 2 );
with draft;

define behavior for ZI_PS_Order alias Order
persistent table zps_order
draft table zps_order_d
lock master total etag last_changed_at
etag master local_last_changed_at
authorization master ( instance )
{
  create;
  update;
  delete;

  association _Customer { create; with draft; }
  association _Pet { create; with draft; }

  field ( readonly ) Id;
  field ( mandatory ) customer_id, pet_id, order_date, total_amount, currency;

  draft action Edit;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare;

  mapping for zps_order
  {
    id = id;
    customer_id = customer_id;
    pet_id = pet_id;
    order_date = order_date;
    total_amount = total_amount;
    currency = currency;
    last_changed_at = last_changed_at;
    local_last_changed_at = local_last_changed_at;
  }
}